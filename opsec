#!/bin/bash
# opsec - fake hacker mode. Pure show, touches nothing on the system.
# Usage: sudo opsec [--fast]

G=$'\e[32m'; BG=$'\e[1;32m'; R=$'\e[1;31m'; Y=$'\e[1;33m'; C=$'\e[1;36m'
W=$'\e[1;97m'; D=$'\e[2;32m'; N=$'\e[0m'

SPEED=1
[ "$1" = "--fast" ] && SPEED=0

if [ "$EUID" -ne 0 ]; then
  echo "${R}[!] opsec: operation not permitted. Root clearance required.${N}"
  echo "${D}    try: sudo opsec${N}"
  exit 1
fi

cleanup() {
  tput cnorm 2>/dev/null; printf '\e[?7h'
  printf '%s\n\n' "$N"
  echo "${R}[!] SIGINT received. Killing session...${N}"
  zz 0.3
  echo "${G}[+] Wiping logs............ ${BG}done${N}"
  zz 0.2
  echo "${G}[+] Shredding RAM cache.... ${BG}done${N}"
  zz 0.2
  echo "${G}[+] Tor circuit closed..... ${BG}done${N}"
  zz 0.3
  echo
  echo "${W}    You were never here.${N}"
  echo
  exit 0
}
trap cleanup INT TERM

zz() { [ "$SPEED" -eq 1 ] && sleep "$1"; }

# read the real window size from the terminal itself; tput inside $(...) sees a pipe and falls back to 80x24
cols() { local s; s=$(stty size </dev/tty 2>/dev/null); echo "${s#* }" | grep -E "^[0-9]+$" || echo 80; }
rows() { local s; s=$(stty size </dev/tty 2>/dev/null); echo "${s% *}" | grep -E "^[0-9]+$" || echo 24; }

type_out() {  # typewriter effect
  local s="$1" i
  for ((i = 0; i < ${#s}; i++)); do
    printf '%s' "${s:i:1}"
    zz 0.012
  done
  printf '\n'
}

rand_ip()  { echo "$((RANDOM % 223 + 1)).$((RANDOM % 256)).$((RANDOM % 256)).$((RANDOM % 254 + 1))"; }
rand_hex() { od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n' | cut -c1-"$1"; }
pick()     { local a=("$@"); echo "${a[RANDOM % ${#a[@]}]}"; }

spinner() {  # spinner "label" seconds
  local label="$1" t=$(( $2 * 10 )) f='|/-\' i
  for ((i = 0; i < t; i++)); do
    printf '\r%s[%s]%s %s' "$Y" "${f:i%4:1}" "$N" "$label"
    zz 0.1
  done
  printf '\r%s[+]%s %s %sOK%s\n' "$BG" "$N" "$label" "$BG" "$N"
}

progress() {  # progress "label"
  local label="$1" w=34 p=0 fill bar
  while [ $p -lt 100 ]; do
    p=$((p + RANDOM % 9 + 1)); [ $p -gt 100 ] && p=100
    fill=$((p * w / 100))
    bar=$(printf '%*s' "$fill" '' | tr ' ' '#')$(printf '%*s' $((w - fill)) '' | tr ' ' '.')
    printf '\r%s%-28s%s [%s%s%s] %3d%%' "$G" "$label" "$N" "$BG" "$bar" "$N" "$p"
    zz 0.0$((RANDOM % 6 + 3))
  done
  printf '\n'
}

banner() {
  clear
  printf '%s' "$BG"
  cat <<'EOF'

    ██████╗ ██████╗ ███████╗███████╗ ██████╗
   ██╔═══██╗██╔══██╗██╔════╝██╔════╝██╔════╝
   ██║   ██║██████╔╝███████╗█████╗  ██║
   ██║   ██║██╔═══╝ ╚════██║██╔══╝  ██║
   ╚██████╔╝██║     ███████║███████╗╚██████╗
    ╚═════╝ ╚═╝     ╚══════╝╚══════╝ ╚═════╝
EOF
  printf '%s' "$N"
  echo "${D}   ghost-shell v6.6.6  //  operator: ${W}$(logname 2>/dev/null || echo root)${D}  //  clearance: ${R}OMEGA${N}"
  echo
}

boot() {
  local mods=(ghost.ko netphantom.ko kstealth.ko tor_bridge.ko memcloak.ko ids_blind.ko)
  local m
  for m in "${mods[@]}"; do
    printf '%s[ %sOK%s ]%s Loading kernel module %s%s%s\n' "$G" "$BG" "$G" "$N" "$W" "$m" "$N"
    zz 0.15
  done
  echo
  spinner "Spoofing MAC address -> $(rand_hex 2):$(rand_hex 2):$(rand_hex 2):$(rand_hex 2):$(rand_hex 2):$(rand_hex 2)" 1
  spinner "Randomizing hostname -> $(pick NULL-NODE SHADOW ZERO-X DARKSTAR PHANTOM)-$(rand_hex 4)" 1
  spinner "Disabling telemetry" 1
  echo
}

proxy_chain() {
  echo "${C}[*] Building onion proxy chain...${N}"
  local lands=(Iceland Romania Panama Seychelles Moldova Switzerland Estonia Belize Malta Tonga) i
  for ((i = 1; i <= 6; i++)); do
    printf '    %shop %d%s  %-16s %s-->%s  %s%s%s  %s(%dms)%s\n' \
      "$D" "$i" "$N" "$(rand_ip)" "$G" "$N" "$W" "$(pick "${lands[@]}")" "$N" "$D" $((RANDOM % 300 + 20)) "$N"
    zz 0.25
  done
  echo "${BG}[+] Location masked. Traceback probability: 0.0003%${N}"
  echo
}

hexdump_fake() {
  local lines=${1:-14} i row
  for ((i = 0; i < lines; i++)); do
    row=$(od -An -N16 -tx2 /dev/urandom | tr -s ' ' | sed 's/^ //')
    printf '%s0x%s%s  %s%s\n' "$D" "$(rand_hex 8)" "$N" "$G" "$row$N"
    zz 0.03
  done
}

crack() {
  local target="$1" charset='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&*'
  local len=${#target} locked=0 out i
  echo "${C}[*] Brute-forcing hash $(rand_hex 32)...${N}"
  while [ $locked -le $len ]; do
    out="${target:0:locked}"
    for ((i = locked; i < len; i++)); do out+="${charset:RANDOM % ${#charset}:1}"; done
    printf '\r    %skey:%s %s%s%s%s%s' "$D" "$N" "$BG" "${out:0:locked}" "$R" "${out:locked}" "$N"
    zz 0.04
    [ $((RANDOM % 4)) -eq 0 ] && locked=$((locked + 1))
  done
  printf '\n%s[+] Hash cracked in %d.%03ds%s\n\n' "$BG" $((RANDOM % 9)) $((RANDOM % 1000)) "$N"
}

matrix() {  # matrix seconds
  local frames=$(( $1 * 20 )) w h c f y frame charset='01ABCDEF#$%&@*+=<>?/\|'
  w=$(cols); h=$(rows)
  local drops=() trail=() t
  # every column gets a drop, spread over the whole screen from the first frame
  for ((c = 1; c <= w; c++)); do
    drops[c]=$(( RANDOM % (h + h / 3) - h / 3 ))
    trail[c]=$(( RANDOM % (h / 2 + 1) + h / 3 + 4 ))
  done
  tput civis; clear
  printf '\e[?7l'  # no autowrap, so the bottom-right cell never scrolls
  for ((f = 0; f < frames; f++)); do
    frame=""
    for ((c = 1; c <= w; c++)); do
      y=${drops[c]} t=${trail[c]}
      if ((y >= 1 && y <= h)); then
        frame+=$'\e['"$y;${c}H$W${charset:RANDOM % ${#charset}:1}"
      fi
      if ((y - 1 >= 1 && y - 1 <= h)); then
        frame+=$'\e['"$((y - 1));${c}H$G${charset:RANDOM % ${#charset}:1}"
      fi
      if ((y - t >= 1 && y - t <= h)); then
        frame+=$'\e['"$((y - t));${c}H "
      fi
      ((y++))
      if ((y - t > h)); then
        y=$(( -(RANDOM % (h / 3 + 1)) ))
        trail[c]=$(( RANDOM % (h / 2 + 1) + h / 3 + 4 ))
      fi
      drops[c]=$y
    done
    printf '%s' "$frame"
    sleep 0.05
  done
  printf '%s\e[?7h' "$N"; clear; tput cnorm
}

access_granted() {
  local w msg="  ACCESS  GRANTED  " pad
  w=$(cols); pad=$(( (w - ${#msg} - 4) / 2 )); [ $pad -lt 0 ] && pad=0
  echo
  printf '%*s%s╔%s╗%s\n' $pad '' "$BG" "$(printf '═%.0s' $(seq 1 $((${#msg} + 2))))" "$N"
  printf '%*s%s║ %s%s%s ║%s\n' $pad '' "$BG" $'\e[5;1;97;42m' "$msg" "$N$BG" "$N"
  printf '%*s%s╚%s╝%s\n' $pad '' "$BG" "$(printf '═%.0s' $(seq 1 $((${#msg} + 2))))" "$N"
  echo
}

target_info() {
  local t="$1"
  echo "${C}[*] Target acquired: ${W}$t${N}"
  printf '    %-12s %s\n' "IP:" "$(rand_ip)" "OS:" "$(pick 'Linux 6.8' 'Windows Server 2019' 'FreeBSD 14' 'Solaris 11' 'Cisco IOS 15.2')" \
    "Open ports:" "$(pick 22 80 443 3306 8080), $(pick 21 25 3389 5432 6379), $(pick 8443 9000 27017 11211)" \
    "Firewall:" "$(pick 'pfSense' 'Palo Alto PA-5450' 'FortiGate 600F' 'Cisco ASA')"
  zz 0.4
  echo
}

module_breach() {
  target_info "$(pick mainframe.$(rand_hex 3).gov db-cluster-0$((RANDOM % 9)).corp satellite-uplink-$(rand_hex 2) swift-gateway.bank vault.$(rand_hex 4).mil)"
  progress "Bypassing firewall"
  progress "Injecting payload"
  progress "Escalating privileges"
  echo
  crack "$(pick 'Tr0ub4dor&3' 'hunter2' 'P@ssw0rd!1337' 'root:toor' 'CorrectHorseBattery')"
  access_granted
  zz 0.8
}

module_exfil() {
  local files=(customers.db salaries_2026.xlsx launch_codes.txt keys.pem shadow backup.tar.gz emails.pst) f
  echo "${C}[*] Exfiltrating data via DNS tunnel...${N}"
  for f in "${files[@]}"; do
    printf '    %s%-22s%s %6d KB  ' "$W" "$f" "$N" $((RANDOM % 90000 + 100))
    printf '%s' "$G"
    local k; for ((k = 0; k < 16; k++)); do printf '▮'; zz 0.02; done
    printf ' %s✓%s\n' "$BG" "$N"
  done
  echo
}

module_scan() {
  local net="$((RANDOM % 223 + 1)).$((RANDOM % 256)).$((RANDOM % 256))" i
  echo "${C}[*] Scanning subnet $net.0/24...${N}"
  for ((i = 0; i < 10; i++)); do
    printf '    %s%s.%-4d%s %s%-6s%s %s\n' "$W" "$net" $((RANDOM % 254 + 1)) "$N" \
      "$BG" "$(pick open open open filtered)" "$N" "$(pick ssh http https mysql redis rdp smb telnet)"
    zz 0.1
  done
  echo
}

module_hex() {
  echo "${C}[*] Dumping memory segment 0x$(rand_hex 8)...${N}"
  hexdump_fake 16
  echo
}

main() {
  banner
  type_out "${G}> Initializing ghost-shell...${N}"
  zz 0.3
  boot
  proxy_chain
  zz 0.5
  matrix 3
  banner
  local mods=(module_breach module_exfil module_scan module_hex)
  while true; do
    "$(pick "${mods[@]}")"
    zz 0.6
    [ $((RANDOM % 5)) -eq 0 ] && { matrix 2; banner; }
  done
}

main
